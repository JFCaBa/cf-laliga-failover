# Obligatorias
CLOUDFLARE_API_TOKEN=token_con_Zone_DNS_Edit_solo_para_tu_zona
CLOUDFLARE_ZONE_ID=id_de_la_zona
CF_FAILOVER_ZONA=example.es

# Opcionales (con sus valores por defecto entre paréntesis)
# CF_FAILOVER_REGISTROS=example.es,www.example.es   (<zona>,www.<zona>)
# CF_FAILOVER_CANARIO=cf-canary.example.es          (cf-canary.<zona>)
# CF_FAILOVER_DIR=/var/lib/cf-laliga-failover
CF_FAILOVER_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
CF_FAILOVER_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/XXXXXXXX
CF_FAILOVER_CONTACTO=ops@example.es
